{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "gavia-ui": ["../../packages/ui-kit/src/index.ts"],
      "gavia-ui/utils": ["../../packages/ui-kit/src/utils/index.ts"],
      "gavia-ui/composables": ["../../packages/ui-kit/src/composables/index.ts"],
      "vue": [
        "./node_modules/vue"
      ],
      "vue/*": [
        "./node_modules/vue/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "e2e/**/*.ts",
    "e2e/**/*.vue",
    "playwright*.config.ts",
    "vite.config.ts",
    "build/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
