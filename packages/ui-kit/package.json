{
  "name": "gavia-ui",
  "version": "0.6.0",
  "description": "Gavia UI — a free, open source Vue 3 and TypeScript component library and design system",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whitewolf06/gavia-ui.git",
    "directory": "packages/ui-kit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/reset.css": "./styles/reset.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/primitives.css": "./styles/primitives.css",
    "./themes/*.css": "./themes/*.css",
    "./manifest.json": "./dist/manifest.json",
    "./design-tokens.json": "./dist/design-tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "themes",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "pack": "pnpm pack",
    "icons:sync": "node scripts/sync-icons.mjs",
    "icons:check": "node scripts/sync-icons.mjs --check",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "homepage": "https://github.com/whitewolf06/gavia-ui#readme",
  "bugs": {
    "url": "https://github.com/whitewolf06/gavia-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "design-system",
    "typescript",
    "gavia"
  ]
}
