{
  "name": "gavia-ui-workspace",
  "version": "0.12.1",
  "private": true,
  "description": "Gavia UI workspace: an independent Vue 3 design system and component library",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "dev": "pnpm --filter gavia-ui-playground dev",
    "build": "pnpm --filter gavia-ui build",
    "build:playground": "pnpm --filter gavia-ui-playground build",
    "test": "pnpm --filter gavia-ui test && pnpm --filter gavia-ui-playground test",
    "typecheck": "pnpm --filter gavia-ui typecheck && pnpm --filter gavia-ui-playground typecheck",
    "pack": "pnpm --filter gavia-ui run pack",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:dependencies": "node scripts/check-dependencies.mjs",
    "test:e2e": "pnpm exec playwright test -c apps/playground/playwright.config.ts",
    "test:visual": "pnpm exec playwright test -c apps/playground/playwright.visual.config.ts",
    "icons:sync": "pnpm --filter gavia-ui icons:sync",
    "icons:check": "pnpm --filter gavia-ui icons:check",
    "tokens:sync": "pnpm --filter gavia-ui tokens:sync",
    "tokens:check": "pnpm --filter gavia-ui tokens:check",
    "build:pages": "pnpm --filter gavia-ui-playground build --base=/gavia-ui/",
    "pages:prerender": "node scripts/prerender-pages.mjs",
    "test:pages": "pnpm exec playwright test -c apps/playground/playwright.pages.config.ts",
    "verify:compatibility": "node scripts/check-compatibility.mjs",
    "verify:package:browser": "node scripts/verify-package.mjs --browser",
    "test:coverage": "pnpm --filter gavia-ui exec vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/tests.json",
    "test:release-tools": "node --test scripts/release-tools.test.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:version": "node scripts/version-release.mjs",
    "release:preview": "node scripts/archive-playground.mjs",
    "quality:update": "node scripts/update-quality-report.mjs",
    "quality:restore": "node scripts/update-quality-report.mjs --restore",
    "test:quality-report": "node --test scripts/update-quality-report.test.mjs",
    "new:component": "node scripts/new-component.mjs",
    "test:component-generator": "node --test scripts/new-component.test.mjs",
    "size": "node scripts/check-size.mjs",
    "test:size-tools": "node --test scripts/size-budget.test.mjs",
    "test:package-tools": "node --test scripts/package-docs.test.mjs scripts/normalize-declarations.test.mjs scripts/archive-fonts.test.mjs",
    "release:font-archive": "node scripts/archive-fonts.mjs",
    "api:sync": "node scripts/sync-api.mjs",
    "api:check": "node scripts/sync-api.mjs --check",
    "test:api-tools": "node --test scripts/sync-api.test.mjs",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "verify:types": "node scripts/check-package-types.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.13.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "globals": "17.13.0",
    "jsonc-eslint-parser": "3.3.0",
    "publint": "0.3.25",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vue-eslint-parser": "10.4.1"
  },
  "pnpm": {
    "overrides": {
      "@changesets/write@0.4.0>human-id": "4.1.3"
    },
    "packageExtensions": {
      "@vue/test-utils@2.4.6": {
        "peerDependencies": {
          "vue": "^3.0.1"
        }
      }
    }
  }
}
