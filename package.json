{
  "name": "whitelife-ui",
  "version": "0.3.0",
  "private": true,
  "description": "WhiteLife UI workspace: @whitelife-core/ui-kit library package and playground app",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @whitelife-core/playground dev",
    "build": "pnpm --filter @whitelife-core/ui-kit build",
    "build:playground": "pnpm --filter @whitelife-core/playground build",
    "test": "pnpm --filter @whitelife-core/ui-kit test",
    "typecheck": "pnpm --filter @whitelife-core/ui-kit typecheck",
    "pack": "pnpm --filter @whitelife-core/ui-kit run pack"
  }
}
